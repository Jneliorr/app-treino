rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra padrão de negação para coleções não explicitadas
    match /{document=**} {
      allow read, write: if false;
    }

    // Regras de isolamento multi-tenant por usuário
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcoleção de rotinas / fichas fixas (Treino A, B, C...)
      match /routines/{routineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcoleção de histórico de sessões executadas (workout logs)
      match /workout_logs/{logId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
